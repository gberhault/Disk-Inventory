//
// Prefix header for all source files of the 'Disk Inventory X' target in the 'Disk Inventory X' project
//

#ifdef __OBJC__
    #import <Cocoa/Cocoa.h>
    #import <Carbon/Carbon.h>

    #import "NSString-DIXExtensions.h"

    //Lightweight replacement for OmniBase's OBPRECONDITION (OmniBase framework removed).
    //Assertion in debug builds; compiled out in release (NDEBUG) like NSAssert.
    #define OBPRECONDITION(expr) NSAssert((expr), @"OBPRECONDITION failed: %s", #expr)
    #define OBPOSTCONDITION(expr) NSAssert((expr), @"OBPOSTCONDITION failed: %s", #expr)
    #define OBASSERT(expr) NSAssert((expr), @"OBASSERT failed: %s", #expr)


	//global variable which enables/disables logging
	extern BOOL g_EnableLogging;
	#define LOG(x, args...) { if (g_EnableLogging) NSLog(x, ## args); }
#endif
